{
  "name": "template",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -k -n backend,frontend \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "build": "npm run lint:types && npm run build -w frontend",
    "test": "vitest run",
    "test:watch": "vitest",
    "check-updates": "ncu -u --workspaces --root",
    "lint:eslint": "eslint .",
    "lint:types": "tsc -p backend && tsc -p frontend",
    "lint:prettier": "prettier --check .",
    "lint:md": "markdownlint-cli2 \"**/*.md\" \"!**/node_modules/**\" \"!.claude/skills/**\"",
    "lint": "concurrently -m1 npm:lint:*",
    "fix:eslint": "eslint . --fix",
    "fix:prettier": "prettier --write .",
    "fix:md": "markdownlint-cli2 --fix \"**/*.md\" \"!**/node_modules/**\" \"!.claude/skills/**\"",
    "fix": "concurrently -m1 npm:fix:*"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@vitest/eslint-plugin": "^1.6.28",
    "concurrently": "^10.0.7",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jiti": "^2.7.0",
    "markdownlint-cli2": "^0.24.1",
    "npm-check-updates": "^23.1.1",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
